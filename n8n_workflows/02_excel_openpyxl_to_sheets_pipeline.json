    {
      "parameters": {
        "jsCode": "const eventKey = $('Workbook webhook').first().json.headers['idempotency-key'];\nconst document = $input.first().json.body;\nreturn document.tabular.flatMap(sheet => sheet.rows.map((data, index) => ({\n  json: {\n    source_key: JSON.stringify([eventKey, sheet.sheet, index + 1]),\n    document_id: document.id,\n    sheet: sheet.sheet,\n    row: index + 1,\n    row_json: JSON.stringify(data),\n  },\n})));"
      },
